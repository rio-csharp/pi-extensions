{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "extensions/compact-tool-ui/**/*.ts",
    "extensions/mcp/**/*.ts",
    "extensions/compact-footer/**/*.ts",
    "extensions/kimi-usage/**/*.ts",
    "extensions/relay-balance/**/*.ts",
    "extensions/relay-providers/**/*.ts",
    "extensions/subagent/**/*.ts",
    "extensions/web/**/*.ts"
  ]
}
